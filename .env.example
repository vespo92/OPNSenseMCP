# OPNsense API Configuration
OPNSENSE_HOST=https://your-opnsense-host:port
OPNSENSE_API_KEY=your-api-key-here
OPNSENSE_API_SECRET=your-api-secret-here
OPNSENSE_VERIFY_SSL=false

# Safety Modes (Optional, recommended for new/untrusted setups)
# These are operator-only settings: they are read from the environment and
# cannot be overridden by the model via the `configure` tool.
#
# OPNSENSE_READ_ONLY=true blocks every mutating request before it is sent
# (API writes AND SSH commands outside a small read-only allowlist), and
# hides write-capable tools from the MCP tool list entirely. Start here if
# you're pointing this at a production router for the first time.
#
# OPNSENSE_DRY_RUN=true lets write tools be called, but simulates the
# request instead of sending it — logs what would have happened and returns
# a synthetic success. Useful for seeing what an agent *would* do before
# trusting it with OPNSENSE_READ_ONLY=false.
#
# If both are set, OPNSENSE_READ_ONLY wins.
# OPNSENSE_READ_ONLY=true
# OPNSENSE_DRY_RUN=true

# Transport Configuration (Optional)
# MCP_TRANSPORT=stdio          # Default: stdio for CLI/desktop use
# MCP_TRANSPORT=sse            # SSE + Streamable HTTP for remote/web use
# MCP_SSE_PORT=3000            # Port for SSE/HTTP transport
# MCP_SSE_HOST=0.0.0.0        # Host for SSE/HTTP transport
# MCP_CORS_ORIGIN=*           # CORS origin for HTTP transport
# Endpoints available in SSE mode:
#   /mcp      - Streamable HTTP (recommended for mcp-remote, MCPJungle, etc.)
#   /sse      - Legacy SSE transport
#   /health   - Health check

# Logging Configuration (Optional)
# LOG_LEVEL=INFO                 # ERROR, WARN, INFO, DEBUG (default: INFO)
# LOG_FILE=/tmp/opnsense-mcp.log # Path to log file (enables file logging)
# LOG_MAX_SIZE=10485760          # Max log file size in bytes before rotation (default: 10MB)
# LOG_MAX_FILES=5                # Number of rotated files to keep (default: 5)

# SSH Configuration (Optional - for advanced features)
OPNSENSE_SSH_HOST=your-opnsense-host
OPNSENSE_SSH_PORT=22
OPNSENSE_SSH_USERNAME=root
# Use either password or SSH key
# OPNSENSE_SSH_PASSWORD=your-password-here
# OPNSENSE_SSH_KEY_PATH=~/.ssh/id_rsa